---
import LanguagePicker from './LanguagePicker.astro';
import Logo from './Logo.astro';
import { toLocale } from '../i18n/locales';
import { localeHref } from '../i18n/paths';
import { getTranslations } from '../i18n/ui';
import { getModules } from '../lib/content';
import { getRouteModules, moduleHref } from '../lib/modules';
import { SITE_NAME } from '../lib/site';

const locale = toLocale(Astro.currentLocale);
const t = getTranslations(locale);
const route = getRouteModules(await getModules(locale));
const first = route[0];
const last = route.at(-1);
const home = localeHref('/', locale);

const links = [
  { label: t.header.home, href: home },
  ...(first ? [{ label: t.header.guide, href: moduleHref(first.id, locale) }] : []),
  ...(last ? [{ label: t.header.prompts, href: moduleHref(last.id, locale) }] : []),
  { label: t.header.glossary, href: moduleHref('glosario', locale) },
  { label: t.header.about, href: moduleHref('acerca', locale) },
];

const strip = (path: string) => path.replace(/\/+$/, '');
const current = strip(Astro.url.pathname);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={home}>
      <Logo />
      <span class="brand__text">
        <span class="brand__name">{SITE_NAME}</span>
        <span class="brand__tagline">{t.site.tagline}</span>
      </span>
    </a>
    <nav class="site-nav no-print" aria-label={t.header.navLabel}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={strip(link.href) === current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LanguagePicker />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding-block: 0.75rem;
  }

  .brand {
    display: inline-flex;
    margin-right: auto;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand__name {
    font-size: 1.1rem;
    font-weight: 800;
  }

  .brand__tagline {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: block;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover {
    background: var(--surface-2);
  }

  .site-nav a[aria-current='page'] {
    background: var(--primary-soft);
    color: var(--primary-strong);
  }

  @media (max-width: 719px) {
    .brand__tagline {
      display: none;
    }

    /* The language picker stays next to the brand; the links wrap onto their own row. */
    .site-nav {
      order: 1;
      width: 100%;
      margin-inline: -0.75rem;
    }
  }
</style>
