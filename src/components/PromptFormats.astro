---
/** Diagram for "generative AI creates new content": one prompt goes in, several kinds of content come out. */
import AiIcon from './AiIcon.astro';
import Figure from './Figure.astro';

type FormatIcon = 'texto' | 'imagen' | 'audio' | 'video' | 'codigo';

interface Props {
  /** Small heading on the prompt card, e.g. "Tu prompt". */
  label: string;
  prompt: string;
  /** Label under the AI icon ("IA", "AI"). */
  ai: string;
  /** What comes out; `icon` stays in Spanish in every language, like Callout's `type`. */
  formats: { icon: FormatIcon; name: string; example: string }[];
  caption?: string;
}

const { label, prompt, ai, formats, caption } = Astro.props;

const icons: Record<FormatIcon, string> = {
  texto: 'M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Zm0 0v6h6M8 13h8M8 17h5',
  imagen: 'M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm-1 12 5-5 4 4 2-2 5 5M15.5 7a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z',
  audio: 'M9 18V5l11-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm11-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  video: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm6 4.5v5l4.5-2.5Z',
  codigo: 'm8 8-4 4 4 4m8-8 4 4-4 4M13.5 6l-3 12',
};
const arrow = 'M3 12h17M14 6l6 6-6 6';
---

<Figure caption={caption}>
  <div class="formats">
    <p class="formats__prompt">
      <span class="formats__label">{label}</span>
      <span class="formats__text">{prompt}</span>
    </p>
    <svg class="formats__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={arrow}></path></svg>
    <div class="formats__ai">
      <AiIcon size={56} />
      <span>{ai}</span>
    </div>
    <svg class="formats__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={arrow}></path></svg>
    <ul class="formats__list">
      {
        formats.map(({ icon, name, example }) => (
          <li class="formats__item">
            <svg class="formats__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d={icons[icon]} />
            </svg>
            <span class="formats__name">{name}</span>
            <span class="formats__example">{example}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Figure>

<style>
  .formats {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .formats__prompt {
    max-width: 22rem;
    margin: 0;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 1.1rem 1.1rem 0.3rem 1.1rem;
    background: var(--surface-2);
    line-height: 1.45;
    text-align: center;
  }

  .formats__label {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .formats__text {
    font-weight: 700;
  }

  .formats__arrow,
  .formats__icon {
    flex-shrink: 0;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .formats__arrow {
    width: 1.5rem;
    height: 1.5rem;
    stroke: var(--text-muted);
    stroke-width: 2.5;
    transform: rotate(90deg);
  }

  .formats__ai {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .formats__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phones: small tiles, icon on top, so the example gets the whole width. */
  .formats__item {
    display: flex;
    flex: 1 1 8rem;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    max-width: 14rem;
    margin: 0;
    padding: 0.55rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--primary-soft);
    line-height: 1.25;
    text-align: center;
  }

  .formats__icon {
    width: 1.4rem;
    height: 1.4rem;
    stroke: var(--primary);
    stroke-width: 2;
  }

  .formats__name {
    font-size: 0.88rem;
    font-weight: 700;
  }

  .formats__example {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  /* Wide enough: prompt → AI → formats from left to right. */
  @container (min-width: 36rem) {
    .formats {
      flex-direction: row;
      gap: 0.75rem;
    }

    .formats__prompt {
      flex: 1 1 0;
    }

    .formats__arrow {
      transform: none;
    }

    .formats__list {
      flex: 1.1 1 0;
      flex-direction: column;
      align-items: stretch;
      width: auto;
    }

    /* Rows: icon on the left of the name and the example. */
    .formats__item {
      display: grid;
      flex: none;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: 0.55rem;
      max-width: none;
      padding: 0.4rem 0.75rem 0.4rem 0.6rem;
      text-align: left;
    }

    .formats__icon {
      grid-row: span 2;
    }
  }
</style>
