---
/** The robot that stands for "the AI" in every figure. Decorative: the figure's text names it. */
interface Props {
  size?: number;
}

const { size = 64 } = Astro.props;
---

<svg class="ai-icon" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <path d="M32 7v8" stroke="var(--primary)" stroke-width="3" stroke-linecap="round"></path>
  <circle cx="32" cy="6" r="4" fill="var(--accent)"></circle>
  <rect x="4" y="27" width="6" height="12" rx="2" fill="var(--primary)"></rect>
  <rect x="54" y="27" width="6" height="12" rx="2" fill="var(--primary)"></rect>
  <rect x="9" y="15" width="46" height="38" rx="12" fill="var(--primary)"></rect>
  <circle cx="24" cy="31" r="4.5" fill="var(--surface)"></circle>
  <circle cx="40" cy="31" r="4.5" fill="var(--surface)"></circle>
  <path d="M22 43q5-4 10 0t10 0" fill="none" stroke="var(--surface)" stroke-width="3" stroke-linecap="round"></path>
</svg>

<style>
  .ai-icon {
    flex-shrink: 0;
  }
</style>
