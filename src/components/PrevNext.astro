---
import Trans from './Trans.astro';
import { toLocale } from '../i18n/locales';
import { getTranslations } from '../i18n/ui';
import type { GuideModule } from '../lib/content';
import { moduleHref } from '../lib/modules';

interface Props {
  step: number;
  prev: GuideModule | undefined;
  next: GuideModule | undefined;
}

const { step, prev, next } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = getTranslations(locale);
const label = (m: GuideModule) => m.data.navTitle ?? m.data.title;
const lang = (m: GuideModule) => (m.lang === locale ? undefined : m.lang);
---

<nav class="prev-next no-print" aria-label={t.prevNext.label}>
  {
    prev ? (
      <a class="prev-next__link" href={moduleHref(prev.id, locale)} rel="prev">
        <span class="prev-next__dir">← {t.nav.step(step - 1)}</span>
        <span class="prev-next__title" lang={lang(prev)}>
          {label(prev)}
        </span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next ? (
      <a class="prev-next__link prev-next__link--next" href={moduleHref(next.id, locale)} rel="next">
        <span class="prev-next__dir">{t.nav.step(step + 1)} →</span>
        <span class="prev-next__title" lang={lang(next)}>
          {label(next)}
        </span>
      </a>
    ) : (
      <div class="prev-next__done">
        <p class="prev-next__title">{t.prevNext.finishedTitle}</p>
        <p>
          <Trans text={t.prevNext.finished}>
            <a slot="glossary" href={moduleHref('glosario', locale)}>
              {t.prevNext.glossary}
            </a>
            <a slot="references" href={moduleHref('referencias', locale)}>
              {t.prevNext.references}
            </a>
          </Trans>
        </p>
      </div>
    )
  }
</nav>

<style>
  .prev-next {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }

  @media (min-width: 720px) {
    .prev-next {
      grid-template-columns: 1fr 1fr;
    }
  }

  .prev-next__link,
  .prev-next__done {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .prev-next__link:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow);
    color: var(--text);
  }

  .prev-next__link--next,
  .prev-next__done {
    text-align: right;
  }

  .prev-next__dir {
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .prev-next__title {
    margin: 0;
    font-weight: 700;
  }

  .prev-next__done {
    background: var(--primary-soft);
    text-align: left;
  }

  .prev-next__done p {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
