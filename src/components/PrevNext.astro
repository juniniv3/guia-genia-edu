---
import type { CollectionEntry } from 'astro:content';
import { moduleHref } from '../lib/modules';

interface Props {
  step: number;
  prev: CollectionEntry<'modulos'> | undefined;
  next: CollectionEntry<'modulos'> | undefined;
}

const { step, prev, next } = Astro.props;
const label = (m: CollectionEntry<'modulos'>) => m.data.navTitle ?? m.data.title;
---

<nav class="prev-next no-print" aria-label="Navegación entre pasos">
  {
    prev ? (
      <a class="prev-next__link" href={moduleHref(prev.id)} rel="prev">
        <span class="prev-next__dir">← Paso {step - 1}</span>
        <span class="prev-next__title">{label(prev)}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next ? (
      <a class="prev-next__link prev-next__link--next" href={moduleHref(next.id)} rel="next">
        <span class="prev-next__dir">Paso {step + 1} →</span>
        <span class="prev-next__title">{label(next)}</span>
      </a>
    ) : (
      <div class="prev-next__done">
        <p class="prev-next__title">¡Terminaste la ruta!</p>
        <p>
          Vuelve a la guía cada vez que lo necesites. Consulta el <a href={moduleHref('glosario')}>glosario</a> o las{' '}
          <a href={moduleHref('referencias')}>referencias</a> para profundizar.
        </p>
      </div>
    )
  }
</nav>

<style>
  .prev-next {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }

  @media (min-width: 720px) {
    .prev-next {
      grid-template-columns: 1fr 1fr;
    }
  }

  .prev-next__link,
  .prev-next__done {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .prev-next__link:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow);
    color: var(--text);
  }

  .prev-next__link--next,
  .prev-next__done {
    text-align: right;
  }

  .prev-next__dir {
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .prev-next__title {
    margin: 0;
    font-weight: 700;
  }

  .prev-next__done {
    background: var(--primary-soft);
    text-align: left;
  }

  .prev-next__done p {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
