---
/** An AI answer shown as a chat bubble, with Flag marks in the text explained by the numbered notes below it. */
import AiIcon from './AiIcon.astro';
import Figure from './Figure.astro';

interface Props {
  /** Heading of the bubble; say it's a made-up example, e.g. "Respuesta de la IA · ejemplo inventado". */
  label: string;
  /** One note per Flag, in order: note 1 explains <Flag n={1}>. */
  notes: string[];
  caption?: string;
}

const { label, notes, caption } = Astro.props;
---

<Figure caption={caption}>
  <div class="answer">
    <div class="answer__bubble">
      <p class="answer__label"><AiIcon size={28} />{label}</p>
      <div class="answer__text"><slot /></div>
    </div>
    <ol class="answer__notes">
      {
        notes.map((note, i) => (
          <li>
            <span class="answer__num">{i + 1}</span>
            <span>{note}</span>
          </li>
        ))
      }
    </ol>
  </div>
</Figure>

<style>
  .answer__bubble {
    padding: 0.9rem 1.1rem 1rem;
    border: 1px solid var(--border);
    border-radius: 1.1rem 1.1rem 1.1rem 0.3rem;
    background: var(--surface-2);
  }

  .answer__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .answer__text {
    line-height: 1.8;
  }

  .answer__text :global(p) {
    margin: 0;
  }

  .answer__notes {
    display: grid;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .answer__notes li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .answer__num {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.05rem;
    border-radius: 50%;
    background: var(--cuidado);
    color: var(--surface);
    font-size: 0.75rem;
    font-weight: 800;
  }

  @media print {
    .answer__num {
      print-color-adjust: exact;
    }
  }
</style>
