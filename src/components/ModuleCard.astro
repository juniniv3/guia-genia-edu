---
import { toLocale } from '../i18n/locales';
import { getTranslations } from '../i18n/ui';
import type { GuideModule } from '../lib/content';
import { moduleHref } from '../lib/modules';

interface Props {
  module: GuideModule;
  step: number;
}

const { module, step } = Astro.props;
const { navTitle, title, summary, readingMinutes } = module.data;
const locale = toLocale(Astro.currentLocale);
const t = getTranslations(locale);
const lang = module.lang === locale ? undefined : module.lang;
---

<a class="module-card" href={moduleHref(module.id, locale)}>
  <span class="module-card__num" aria-hidden="true">{step}</span>
  <span class="module-card__body">
    <span class="module-card__title">
      <span class="visually-hidden">{t.nav.step(step)}: </span><span lang={lang}>{navTitle ?? title}</span>
    </span>
    <span class="module-card__summary" lang={lang}>{summary}</span>
    <span class="module-card__time">{t.module.readingTime(readingMinutes)}</span>
  </span>
</a>

<style>
  .module-card {
    display: flex;
    gap: 1rem;
    height: 100%;
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .module-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow);
    color: var(--text);
  }

  .module-card__num {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 800;
  }

  .module-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .module-card__title {
    font-weight: 700;
    line-height: 1.3;
  }

  .module-card__summary {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .module-card__time {
    margin-top: auto;
    padding-top: 0.4rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
  }
</style>
