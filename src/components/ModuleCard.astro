---
import type { CollectionEntry } from 'astro:content';
import { moduleHref } from '../lib/modules';

interface Props {
  entry: CollectionEntry<'modulos'>;
  step: number;
}

const { entry, step } = Astro.props;
const { navTitle, title, summary, readingMinutes } = entry.data;
---

<a class="module-card" href={moduleHref(entry.id)}>
  <span class="module-card__num" aria-hidden="true">{step}</span>
  <span class="module-card__body">
    <span class="module-card__title"><span class="visually-hidden">Paso {step}: </span>{navTitle ?? title}</span>
    <span class="module-card__summary">{summary}</span>
    <span class="module-card__time">{readingMinutes} min de lectura</span>
  </span>
</a>

<style>
  .module-card {
    display: flex;
    gap: 1rem;
    height: 100%;
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .module-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow);
    color: var(--text);
  }

  .module-card__num {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 800;
  }

  .module-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .module-card__title {
    font-weight: 700;
    line-height: 1.3;
  }

  .module-card__summary {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .module-card__time {
    margin-top: auto;
    padding-top: 0.4rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
  }
</style>
