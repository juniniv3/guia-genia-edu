---
/** A short flow of yes/no questions: wraps Decision cards, joined by arrows from one question to the next. */
import Figure from './Figure.astro';

interface Props {
  caption?: string;
}

const { caption } = Astro.props;
---

<Figure caption={caption}>
  <ol class="decisions"><slot /></ol>
</Figure>

<style>
  .decisions {
    --gap: 2.4rem;

    display: grid;
    gap: var(--gap);
    max-width: 34rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
</style>
