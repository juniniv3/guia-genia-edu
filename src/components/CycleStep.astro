---
/**
 * One of the six cards of a CreationCycle, numbered automatically, with an arrow to the next card. The loop
 * positions and arrow directions below assume exactly six steps.
 */
import AiIcon from './AiIcon.astro';
import PersonIcon from './PersonIcon.astro';

interface Props {
  /** `docente` or `ia` (the AI takes part in this step); stays in Spanish in every language. */
  who: 'docente' | 'ia';
  title: string;
}

const { who, title } = Astro.props;
---

<li class:list={['step', `step--${who}`]}>
  <svg class="step__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M3 12h17M14 6l6 6-6 6"></path>
  </svg>
  {who === 'ia' ? <AiIcon size={30} /> : <PersonIcon size={30} />}
  <span class="step__title">{title}</span>
  <div class="step__text"><slot /></div>
</li>

<style>
  .step {
    --tone: var(--accent);
    --tone-bg: var(--accent-soft);

    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0.7rem 0.6rem 0.8rem;
    border-top: 4px solid var(--tone);
    border-radius: var(--radius-sm);
    background: var(--tone-bg);
    line-height: 1.35;
    text-align: center;
    counter-increment: cycle-step;
  }

  .step--ia {
    --tone: var(--primary);
    --tone-bg: var(--primary-soft);
  }

  .step__title {
    color: var(--tone);
    font-size: 0.95rem;
    font-weight: 800;
  }

  .step__title::before {
    content: counter(cycle-step) '. ';
  }

  .step__text {
    font-size: 0.82rem;
  }

  .step__text :global(p) {
    margin: 0;
  }

  .step__arrow {
    position: absolute;
    width: var(--arrow);
    height: var(--arrow);
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /*
   * Phones, 2 × 3, clockwise: 1 2 / 6 3 / 5 4. Each arrow sits in the gap and points to the next step.
   */
  .step:nth-child(1) {
    grid-area: 1 / 1;
  }

  .step:nth-child(2) {
    grid-area: 1 / 2;
  }

  .step:nth-child(3) {
    grid-area: 2 / 2;
  }

  .step:nth-child(4) {
    grid-area: 3 / 2;
  }

  .step:nth-child(5) {
    grid-area: 3 / 1;
  }

  .step:nth-child(6) {
    grid-area: 2 / 1;
  }

  .step:nth-child(1) .step__arrow {
    top: 50%;
    left: calc(100% + var(--arrow-offset));
    transform: translateY(-50%);
  }

  .step:nth-child(2) .step__arrow,
  .step:nth-child(3) .step__arrow {
    top: calc(100% + var(--arrow-offset));
    left: 50%;
    transform: translateX(-50%) rotate(90deg);
  }

  .step:nth-child(4) .step__arrow {
    top: 50%;
    right: calc(100% + var(--arrow-offset));
    transform: translateY(-50%) rotate(180deg);
  }

  .step:nth-child(5) .step__arrow,
  .step:nth-child(6) .step__arrow {
    bottom: calc(100% + var(--arrow-offset));
    left: 50%;
    transform: translateX(-50%) rotate(-90deg);
  }

  /* Wider, 3 × 2, clockwise: 1 2 3 / 6 5 4. */
  @container (min-width: 36rem) {
    .step:nth-child(3) {
      grid-area: 1 / 3;
    }

    .step:nth-child(4) {
      grid-area: 2 / 3;
    }

    .step:nth-child(5) {
      grid-area: 2 / 2;
    }

    .step:nth-child(6) {
      grid-area: 2 / 1;
    }

    .step:nth-child(n) .step__arrow {
      inset: auto;
    }

    .step:nth-child(1) .step__arrow,
    .step:nth-child(2) .step__arrow {
      top: 50%;
      left: calc(100% + var(--arrow-offset));
      transform: translateY(-50%);
    }

    .step:nth-child(3) .step__arrow {
      top: calc(100% + var(--arrow-offset));
      left: 50%;
      transform: translateX(-50%) rotate(90deg);
    }

    .step:nth-child(4) .step__arrow,
    .step:nth-child(5) .step__arrow {
      top: 50%;
      right: calc(100% + var(--arrow-offset));
      transform: translateY(-50%) rotate(180deg);
    }

    .step:nth-child(6) .step__arrow {
      bottom: calc(100% + var(--arrow-offset));
      left: 50%;
      transform: translateX(-50%) rotate(-90deg);
    }
  }

  @media print {
    .step {
      print-color-adjust: exact;
    }
  }
</style>
