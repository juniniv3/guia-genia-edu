---
import { toLocale } from '../i18n/locales';
import { getTranslations } from '../i18n/ui';
import { moduleHref } from '../lib/modules';
import { SITE_NAME } from '../lib/site';

const locale = toLocale(Astro.currentLocale);
const t = getTranslations(locale).footer;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name">{SITE_NAME} · {t.edition}</p>
      <p>{t.credits}</p>
      <p class="site-footer__note">{t.reminder}</p>
    </div>
    <nav class="no-print" aria-label={t.navLabel}>
      <ul>
        <li><a href={moduleHref('glosario', locale)}>{t.glossary}</a></li>
        <li><a href={moduleHref('referencias', locale)}>{t.references}</a></li>
        <li><a href={moduleHref('acerca', locale)}>{t.about}</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 3rem;
    padding-block: 2rem;
  }

  .site-footer__inner > div {
    max-width: 60ch;
  }

  .site-footer p {
    margin: 0 0 0.5rem;
  }

  .site-footer__name {
    color: var(--text);
    font-weight: 700;
  }

  .site-footer__note {
    font-style: italic;
  }

  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer li + li {
    margin-top: 0.3rem;
  }
</style>
