---
/** Diagram of the CLEAR framework: the qualities to check before sending a prompt, then the ones for the answer. */
import Figure from './Figure.astro';

interface Props {
  beforeLabel: string;
  /** Qualities to check before sending; each word's first letter is shown large ("Conciso" → C). */
  before: string[];
  afterLabel: string;
  after: string[];
  caption?: string;
}

const { beforeLabel, before, afterLabel, after, caption } = Astro.props;
const groups = [
  { label: beforeLabel, words: before, tone: 'primary' },
  { label: afterLabel, words: after, tone: 'accent' },
];
---

<Figure caption={caption}>
  <div class="clear">
    {
      groups.map(({ label, words, tone }, i) => (
        <>
          {i > 0 && (
            <svg class="clear__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3 12h17M14 6l6 6-6 6" />
            </svg>
          )}
          <div class:list={['clear__group', `clear__group--${tone}`]}>
            <p class="clear__label">{label}</p>
            <ul class="clear__tiles">
              {words.map((word) => (
                <li class="clear__tile">
                  <span class="clear__letter" aria-hidden="true">
                    {word.charAt(0)}
                  </span>
                  <span class="clear__word">{word}</span>
                </li>
              ))}
            </ul>
          </div>
        </>
      ))
    }
  </div>
</Figure>

<style>
  .clear {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .clear__group {
    --tone: var(--primary);
    --tone-bg: var(--primary-soft);

    width: 100%;
  }

  .clear__group--accent {
    --tone: var(--accent);
    --tone-bg: var(--accent-soft);
  }

  .clear__label {
    margin: 0 0 0.45rem;
    color: var(--tone);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-align: center;
    text-transform: uppercase;
  }

  .clear__tiles {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .clear__tile {
    display: flex;
    flex: 0 1 6rem;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    margin: 0;
    padding: 0.45rem 0.3rem 0.55rem;
    border-top: 4px solid var(--tone);
    border-radius: var(--radius-sm);
    background: var(--tone-bg);
  }

  .clear__letter {
    color: var(--tone);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .clear__word {
    max-width: 100%;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .clear__arrow {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: rotate(90deg);
  }

  /* Wide enough: both groups side by side, the arrow pointing from one to the other. */
  @container (min-width: 34rem) {
    .clear {
      flex-direction: row;
      align-items: flex-end;
    }

    .clear__group {
      width: auto;
    }

    .clear__group--primary {
      flex: 3 1 0;
    }

    .clear__group--accent {
      flex: 2 1 0;
    }

    .clear__arrow {
      align-self: center;
      flex-shrink: 0;
      margin-top: 1.3rem;
      transform: none;
    }
  }

  @media print {
    .clear__tile {
      print-color-adjust: exact;
    }
  }
</style>
