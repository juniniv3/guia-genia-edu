---
/**
 * A "photo" of a cat for LearnFromExamples: a flat drawing, each `picture` a different cat in a different pose. The
 * ears, whiskers and tail have the class `cat-feature`, so the figure can highlight what every cat has in common.
 */
interface Props {
  /** Which cat; stays in Spanish in every language, like PromptFormats' `icon`. */
  picture: 'naranja' | 'gris' | 'negro' | 'blanco' | 'siames';
  /** What the photo shows, for screen readers. */
  alt: string;
}

const { picture, alt } = Astro.props;
---

<svg class="cat-photo" viewBox="0 0 64 64" role="img" aria-label={alt}>
  {
    picture === 'naranja' && (
      <g>
        <rect width="64" height="64" fill="#dbe8f3" />
        <rect y="52" width="64" height="12" fill="#c3d5e6" />
        <path class="cat-feature" d="M42 55c11 2 14-6 9-14" fill="none" stroke="#e8973f" stroke-width="4.5" stroke-linecap="round" />
        <path d="M20 57c-2-13 4-23 12-23s14 10 12 23Z" fill="#e8973f" />
        <ellipse cx="32" cy="46" rx="6" ry="8" fill="#f8dcb8" />
        <ellipse cx="27" cy="57" rx="4" ry="2.4" fill="#f8dcb8" />
        <ellipse cx="37" cy="57" rx="4" ry="2.4" fill="#f8dcb8" />
        <path class="cat-feature" d="M22 18 21 8.5l8.5 5.5Zm20 0 1-9.5-8.5 5.5Z" fill="#e8973f" stroke="#e8973f" stroke-width="2" stroke-linejoin="round" />
        <path d="m23 15-.6-4.8 4 3.2Zm18 0 .6-4.8-4 3.2Z" fill="#f2a99a" />
        <circle cx="32" cy="23" r="11" fill="#e8973f" />
        <path d="M29 13.5v4m3-5v5m3-4v4" stroke="#c4691a" stroke-width="1.6" stroke-linecap="round" />
        <ellipse cx="27.5" cy="23" rx="2.2" ry="2.6" fill="#7cb342" />
        <ellipse cx="36.5" cy="23" rx="2.2" ry="2.6" fill="#7cb342" />
        <ellipse cx="27.5" cy="23" rx="0.8" ry="2" fill="#1e1e1e" />
        <ellipse cx="36.5" cy="23" rx="0.8" ry="2" fill="#1e1e1e" />
        <path d="M30.4 27h3.2L32 29Z" fill="#d9706a" />
        <path class="cat-feature" d="m27 28.5-10-1.5m10 3-10 1.5m20-3 10-1.5m-10 3 10 1.5" stroke="#6b4423" stroke-width="1.2" stroke-linecap="round" />
      </g>
    )
  }
  {
    picture === 'gris' && (
      <g>
        <rect width="64" height="64" fill="#f1e4d1" />
        <rect y="50" width="64" height="14" fill="#dcc7a9" />
        <path class="cat-feature" d="M53 50c8 4 5 9-5 8.5H32" fill="none" stroke="#8f99a3" stroke-width="4.5" stroke-linecap="round" />
        <ellipse cx="38" cy="47" rx="17" ry="10" fill="#8f99a3" />
        <path d="M35 38.5q2 4 0 8m6-8.5q2 4 0 8m6-6.5q2 3.5 0 7" fill="none" stroke="#6f7983" stroke-width="2" stroke-linecap="round" />
        <ellipse cx="23" cy="56.5" rx="5" ry="2.5" fill="#c3cad0" />
        <path class="cat-feature" d="M12.5 33 12 22l7.5 6.5Zm15 0 .5-11-7.5 6.5Z" fill="#8f99a3" stroke="#8f99a3" stroke-width="2" stroke-linejoin="round" />
        <circle cx="20" cy="37" r="10" fill="#8f99a3" />
        <ellipse cx="20" cy="41.5" rx="5" ry="3.5" fill="#c3cad0" />
        <ellipse cx="16" cy="35.5" rx="1.9" ry="2.3" fill="#e0b93a" />
        <ellipse cx="24" cy="35.5" rx="1.9" ry="2.3" fill="#e0b93a" />
        <ellipse cx="16" cy="35.5" rx="0.7" ry="1.8" fill="#1e1e1e" />
        <ellipse cx="24" cy="35.5" rx="0.7" ry="1.8" fill="#1e1e1e" />
        <path d="M18.6 39.5h2.8L20 41.2Z" fill="#d9706a" />
        <path class="cat-feature" d="m16 41.5-10-1.5m10 3-10 1.5m18-3 10-1.5m-10 3 10 1.5" stroke="#3f464d" stroke-width="1.2" stroke-linecap="round" />
      </g>
    )
  }
  {
    picture === 'negro' && (
      <g>
        <rect width="64" height="64" fill="#dcebd2" />
        <rect y="54" width="64" height="10" fill="#b5d39f" />
        <path class="cat-feature" d="M19 37C9 34 8 23 13 15" fill="none" stroke="#26262b" stroke-width="4" stroke-linecap="round" />
        <path d="M23 44v11m6-10v10m11-10v10m6-11v11" stroke="#26262b" stroke-width="4" stroke-linecap="round" />
        <ellipse cx="34" cy="40" rx="16" ry="8" fill="#26262b" />
        <path class="cat-feature" d="M42.5 25 42 14l6.5 6.5Zm11 0 .5-11-6.5 6.5Z" fill="#26262b" stroke="#26262b" stroke-width="2" stroke-linejoin="round" />
        <circle cx="48" cy="28" r="8" fill="#26262b" />
        <ellipse cx="45" cy="27" rx="1.7" ry="2.1" fill="#e8c547" />
        <ellipse cx="51" cy="27" rx="1.7" ry="2.1" fill="#e8c547" />
        <ellipse cx="45" cy="27" rx="0.6" ry="1.6" fill="#1e1e1e" />
        <ellipse cx="51" cy="27" rx="0.6" ry="1.6" fill="#1e1e1e" />
        <path d="M46.8 30.5h2.4L48 32Z" fill="#e58f9a" />
        <path class="cat-feature" d="m45 32-9-1.5m9 3-9 1.5m15-3 9-1.5m-9 3 9 1.5" stroke="#d9d9d9" stroke-width="1.2" stroke-linecap="round" />
      </g>
    )
  }
  {
    picture === 'blanco' && (
      <g>
        <rect width="64" height="64" fill="#e6dcf0" />
        <rect y="52" width="64" height="12" fill="#d5c7e8" />
        <ellipse cx="36" cy="42" rx="18" ry="13" fill="#faf7f2" stroke="#c9bcae" />
        <ellipse cx="44" cy="35" rx="7" ry="4.5" fill="#b07a45" />
        <ellipse cx="34" cy="49" rx="5" ry="3" fill="#b07a45" />
        <path d="M53 44c3 11-11 14-27 12" fill="none" stroke="#c9bcae" stroke-width="6" stroke-linecap="round" />
        <path class="cat-feature" d="M53 44c3 11-11 14-27 12" fill="none" stroke="#faf7f2" stroke-width="4.5" stroke-linecap="round" />
        <path class="cat-feature" d="M13 39 12 29l7 6Z" fill="#faf7f2" stroke="#c9bcae" stroke-width="1.5" stroke-linejoin="round" />
        <path class="cat-feature" d="m21 35 5-7 1 10Z" fill="#b07a45" stroke="#b07a45" stroke-width="1.5" stroke-linejoin="round" />
        <circle cx="20" cy="44" r="9" fill="#faf7f2" stroke="#c9bcae" />
        <path d="M15 43.5q2 1.6 4 0m3 0q2 1.6 4 0" fill="none" stroke="#6b5a4a" stroke-width="1.2" stroke-linecap="round" />
        <path d="M19.2 46.5h2.6L20.5 48Z" fill="#e58f9a" />
        <path class="cat-feature" d="m17 48-9-1.5m9 3-9 1.5m15-3 9-1.5m-9 3 9 1.5" stroke="#9a8a7a" stroke-width="1.2" stroke-linecap="round" />
      </g>
    )
  }
  {
    picture === 'siames' && (
      <g>
        <rect width="64" height="64" fill="#f0b8a8" />
        <rect y="52" width="64" height="12" fill="#e29f8e" />
        <path class="cat-feature" d="M22 56C10 58 7 48 13 41" fill="none" stroke="#5b4636" stroke-width="4.5" stroke-linecap="round" />
        <path d="M21 57c-2-13 4-23 11-23s13 10 11 23Z" fill="#efe3cf" />
        <ellipse cx="27" cy="57" rx="4" ry="2.4" fill="#5b4636" />
        <ellipse cx="37" cy="57" rx="4" ry="2.4" fill="#5b4636" />
        <circle cx="51" cy="53" r="6" fill="#4a7fc1" />
        <path d="M46 51q5 3 10 0m-9.5 4q5 3 9.5-1M49 47.5q-2 5 1 11M45.5 56q-4 2-6 0" fill="none" stroke="#2f5e9a" />
        <g transform="rotate(-12 32 23)">
          <path class="cat-feature" d="M23 19 21.5 8l8.5 6Zm18 0 1.5-11-8.5 6Z" fill="#5b4636" stroke="#5b4636" stroke-width="2" stroke-linejoin="round" />
          <circle cx="32" cy="23" r="10.5" fill="#efe3cf" />
          <ellipse cx="32" cy="26.5" rx="6.5" ry="5.5" fill="#7a6250" />
          <ellipse cx="28.3" cy="23.5" rx="2" ry="2.4" fill="#5aa9e6" />
          <ellipse cx="35.7" cy="23.5" rx="2" ry="2.4" fill="#5aa9e6" />
          <ellipse cx="28.3" cy="23.5" rx="0.7" ry="1.8" fill="#1e1e1e" />
          <ellipse cx="35.7" cy="23.5" rx="0.7" ry="1.8" fill="#1e1e1e" />
          <path d="M30.8 27.5h2.4L32 29Z" fill="#2f241c" />
          <path class="cat-feature" d="m28 29.5-10-1.5m10 3-10 1.5m18-3 10-1.5m-10 3 10 1.5" stroke="#3d2f25" stroke-width="1.2" stroke-linecap="round" />
        </g>
      </g>
    )
  }
</svg>

<style>
  .cat-photo {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
