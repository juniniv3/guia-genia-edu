---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModuleCard from '../../components/ModuleCard.astro';
import { LOCALES, toLocale } from '../../i18n/locales';
import { localeParam } from '../../i18n/paths';
import { getTranslations } from '../../i18n/ui';
import { getModules } from '../../lib/content';
import { getResourceModules, getRouteModules, moduleHref } from '../../lib/modules';
import { SITE_NAME } from '../../lib/site';

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale: localeParam(locale) } }))) satisfies GetStaticPaths;

const locale = toLocale(Astro.currentLocale);
const t = getTranslations(locale).home;
const modules = await getModules(locale);
const route = getRouteModules(modules);
const resources = getResourceModules(modules);
const totalMinutes = route.reduce((sum, m) => sum + m.data.readingMinutes, 0);
const first = route[0];
const library = route.at(-1);
---

<BaseLayout title={SITE_NAME} description={t.description}>
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
      <p class="hero__lead">{t.lead(route.length)}</p>
      <div class="hero__actions">
        {first && <a class="button" href={moduleHref(first.id, locale)}>{t.start}</a>}
        {
          library && (
            <a class="button button--ghost" href={moduleHref(library.id, locale)}>
              {t.seePrompts}
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="principle">
      <p class="principle__quote">{t.principleQuote}</p>
      <p>{t.principle}</p>
    </div>
  </section>

  <section class="container section" aria-labelledby="para-quien">
    <h2 id="para-quien">{t.audienceTitle}</h2>
    <ul class="audience">
      {
        t.audiences.map((a) => (
          <li>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container section" aria-labelledby="ruta">
    <h2 id="ruta">{t.routeTitle(route.length)}</h2>
    <p class="section__intro">{t.routeIntro(totalMinutes)}</p>
    <ol class="route">
      {
        route.map((module, i) => (
          <li>
            <ModuleCard module={module} step={i + 1} />
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section two-cols">
    <div>
      <h2>{t.outcomesTitle}</h2>
      <ul class="outcomes">
        {t.outcomes.map((o) => <li>{o}</li>)}
      </ul>
    </div>
    <div>
      <h2>{t.resourcesTitle}</h2>
      <ul class="resources">
        {
          resources.map((m) => (
            <li lang={m.lang === locale ? undefined : m.lang}>
              <a href={moduleHref(m.id, locale)}>{m.data.navTitle ?? m.data.title}</a>
              <span>{m.data.summary}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 85% 20%, var(--accent-soft), transparent 45%),
      radial-gradient(circle at 10% 90%, var(--primary-soft), transparent 50%);
  }

  .hero__inner {
    padding-block: 3.5rem 3rem;
  }

  .hero h1 {
    max-width: 22ch;
    margin: 0 0 1rem;
    font-size: clamp(2rem, 1.3rem + 3vw, 3.2rem);
  }

  .hero__lead {
    max-width: 60ch;
    margin: 0 0 1.75rem;
    color: var(--text-muted);
    font-size: 1.15rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .section {
    padding-top: 3rem;
  }

  .section h2 {
    margin: 0 0 0.75rem;
    font-size: 1.7rem;
  }

  .section__intro {
    margin: 0 0 1.5rem;
    color: var(--text-muted);
  }

  .principle {
    max-width: 60rem;
    padding: 1.5rem 1.75rem;
    border-left: 6px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .principle p {
    margin: 0;
  }

  .principle__quote {
    margin-bottom: 0.5rem !important;
    color: var(--accent);
    font-size: 1.5rem;
    font-weight: 800;
  }

  .audience,
  .route {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .audience li {
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .audience h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }

  .audience p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .two-cols {
    display: grid;
    gap: 2rem 3rem;
  }

  @media (min-width: 860px) {
    .two-cols {
      grid-template-columns: 3fr 2fr;
    }
  }

  .outcomes {
    margin: 0;
    padding-left: 1.4rem;
  }

  .outcomes li {
    margin-bottom: 0.5rem;
  }

  .outcomes li::marker {
    color: var(--primary);
  }

  .resources {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resources li {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .resources a {
    font-weight: 700;
  }

  .resources span {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
