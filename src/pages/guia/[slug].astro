---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ModuleLayout from '../../layouts/ModuleLayout.astro';

export const getStaticPaths = (async () => {
  const modules = await getCollection('modulos');
  return modules.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'modulos'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ModuleLayout entry={entry} headings={headings}>
  <Content />
</ModuleLayout>
