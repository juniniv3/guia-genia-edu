---
import type { MarkdownHeading } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ModuleNav from '../components/ModuleNav.astro';
import PrevNext from '../components/PrevNext.astro';
import { getAdjacent, getRouteModules, getStepNumber, moduleHref } from '../lib/modules';

interface Props {
  entry: CollectionEntry<'modulos'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, description, readingMinutes, sources } = entry.data;

const modules = await getCollection('modulos');
const totalSteps = getRouteModules(modules).length;
const step = getStepNumber(modules, entry.id);
const { prev, next } = getAdjacent(modules, entry.id);
const position = step ? `Paso ${step} de ${totalSteps}` : 'Recursos';
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={title} description={description}>
  <div class="container module-page">
    <aside class="module-page__sidebar no-print">
      <ModuleNav modules={modules} currentId={entry.id} />
    </aside>

    <details class="module-page__mobile-nav no-print">
      <summary>{position} · Ver todos los pasos</summary>
      <ModuleNav modules={modules} currentId={entry.id} />
    </details>

    <article class="module">
      <header class="module__header">
        <p class="eyebrow">{position} · {readingMinutes} min de lectura</p>
        <h1>{title}</h1>
        <p class="module__lead">{description}</p>
      </header>

      {
        toc.length > 1 && (
          <nav class="module__toc no-print" aria-label="En esta página">
            <p class="module__toc-title">En esta página</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="prose">
        <slot />
      </div>

      {
        sources.length > 0 && (
          <section class="module__sources" aria-labelledby="fuentes">
            <h2 id="fuentes">Fuentes de este módulo</h2>
            <ul>
              {sources.map((source) => (
                <li>{source}</li>
              ))}
            </ul>
            <p>
              Consulta los datos completos en <a href={moduleHref('referencias')}>Referencias</a>.
            </p>
          </section>
        )
      }

      {step && <PrevNext step={step} prev={prev} next={next} />}
    </article>
  </div>
</BaseLayout>

<style>
  .module-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.5rem 0;
  }

  .module-page__sidebar {
    display: none;
  }

  .module-page__mobile-nav {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .module-page__mobile-nav summary {
    padding: 0.75rem 1rem;
    color: var(--primary-strong);
    font-weight: 700;
    cursor: pointer;
  }

  .module-page__mobile-nav[open] summary {
    border-bottom: 1px solid var(--border);
  }

  .module-page__mobile-nav :global(.module-nav) {
    padding: 0.75rem;
  }

  @media (min-width: 960px) {
    .module-page {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 3rem;
      padding-top: 2.5rem;
    }

    .module-page__sidebar {
      display: block;
      position: sticky;
      top: 1.5rem;
      align-self: start;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
      padding-right: 0.25rem;
    }

    .module-page__mobile-nav {
      display: none;
    }
  }

  .module {
    min-width: 0;
  }

  .module__header {
    max-width: var(--measure);
  }

  .module__header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.6rem);
  }

  .module__lead {
    margin: 0 0 1.5rem;
    color: var(--text-muted);
    font-size: 1.12rem;
  }

  .module__toc {
    max-width: var(--measure);
    margin-bottom: 2rem;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 0.92rem;
  }

  .module__toc-title {
    margin: 0 0 0.35rem;
    font-weight: 700;
  }

  .module__toc ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .module__toc li {
    margin: 0.15rem 0;
  }

  .module__sources {
    max-width: var(--measure);
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .module__sources h2 {
    margin: 0 0 0.5rem;
    color: var(--text);
    font-size: 1rem;
  }

  .module__sources ul {
    margin: 0 0 0.5rem;
    padding-left: 1.2rem;
  }

  .module__sources p {
    margin: 0;
  }
</style>
